using namespace Kokkos;

void saxpy (int n, float a, const float *x, float *y) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) {
    y[i] = a * x[i] + y[i];
  }
}

int main() {
  int n = 1000000;
  float a = 2.0;
  float *x = new float[n];
