#include <Kokkos_Core.hpp>

using namespace Kokkos;

void sdot(int n, float *x, float *y, float *sum) {
  int i = threadIdx.x + blockIdx.x * blockDim.x;
  float update = 0.0;
  if (i < n) {
    update = x[i] * y[i];
  }
  atomicAdd(sum, update);
}

int main() {
  int n = 1000000;
  float *x, *y, *sum;
  x = new float[n];
  y = new float[n];
  sum = new float[1];
  for (int i = 0; i < n; i++) {
    x[i] = 1.0;
    y[i] = 1.0;
  }
  sdot(n, x, y, sum);
  printf("sum = %f\n", sum[0]);
  delete[] x;
  delete[] y;
  delete[] sum;
}
```

