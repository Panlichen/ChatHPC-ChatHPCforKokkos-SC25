#include <Kokkos_Core.hpp>
#include <cstdio>

int main(int argc, char* argv[]) {
  Kokkos::initialize(argc, argv);
  {
    const int n = 1000;
    double A[n][n], x[n], y[n];
    for (int i = 0; i < n; ++i) {
      for (int j = 0; j < n; ++j) {
        A[i][j] = 1.0;
      }
      x[i] = 1.0;
    }

    Kokkos::parallel_for(n, KOKKOS_LAMBDA(const int i) {
      double sum = 0.0;
      for (int j = 0; j < n; ++j) {
        sum += A[i][j] * x[j];
      }
      y[i] = sum;
    });

    for (int i = 0; i < n; ++i) {
      printf("%f\n", y[i]);
    }
  }
  Kokkos::finalize();
}
