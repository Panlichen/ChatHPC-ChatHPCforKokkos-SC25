        // The parallel loop
        Kokkos::parallel_for("spmv", n, KOKKOS_LAMBDA(const int i) {
            double sum = 0.0;
            for (int j = row(i); j < row(i+1); j++) {
                sum += val(j) * x(col(j));
            }
            y(i) = sum;
        });
        
